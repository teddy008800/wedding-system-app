{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/WeddingAqilSyafiqah/browser",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/index.html"
    }
  ]
}
